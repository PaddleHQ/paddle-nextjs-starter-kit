# Copy to .env.local and fill in. src/env.ts validates these when the app builds and starts.

# Postgres connection string. `docker compose up -d` starts one at postgres://postgres:postgres@localhost:5432/paddle
DATABASE_URL=

# sandbox or production. Every Paddle credential below must come from the same environment.
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Paddle > Developer tools > Authentication. Starts with pdl_sdbx_apikey_ (sandbox) or pdl_live_apikey_ (production).
PADDLE_API_KEY=

# Paddle > Developer tools > Authentication > Client-side tokens. Starts with test_ (sandbox) or live_ (production).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Paddle > Developer tools > Notifications. Create a destination at <your app URL>/api/auth/paddle/webhook,
# subscribed to every subscription.* event, and paste its secret key here.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# Better Auth. Generate the secret with `pnpm dlx auth secret` or `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: GitHub login. Set both or neither. Create an OAuth app at https://github.com/settings/developers
# with the callback URL http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
